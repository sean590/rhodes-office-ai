{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/compliance-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/inference",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/orphan-sweep",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/process-queue",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/cron/inbound-poll",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/refresh-overviews",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/retrieve-safesend",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/hard-delete-orgs",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}